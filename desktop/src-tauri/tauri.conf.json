{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offerly",
  "version": "0.25.13",
  "identifier": "app.offerly.desktop",
  "build": {
    "frontendDist": "https://offerly-c8b.pages.dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Offerly",
        "url": "https://offerly-c8b.pages.dev/",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Юрий Самусенко",
    "copyright": "© Юрий Самусенко",
    "category": "Education",
    "shortDescription": "Offerly — тренер подготовки к собеседованию на английском",
    "longDescription": "Offerly: тест уровня, программа на четыре недели, занятия, карточки ошибок, репетиция интервью. Приложение для Windows открывает offerly-c8b.pages.dev в своём окне, живёт в трее, показывает напоминания и обновляется само.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Offerly"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4ODVBNjNCREQ2Qjk2NEIKUldSTGxtdmRPNmFGMkp4UDFXUUVKWFYzd2dIWXVsdHNhOU9Td2lRZlAxZjFnd3NUTHV2WkcrVncK",
      "endpoints": ["https://github.com/ysamussenko-cell/offerly/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
